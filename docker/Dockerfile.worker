# syntax=docker/dockerfile:1.7

FROM alpine:3.22 AS stockfish-build
RUN apk add --no-cache build-base git
WORKDIR /stockfish
RUN git clone --depth 1 --branch sf_18 https://github.com/official-stockfish/Stockfish.git . \
  && test "$(git rev-parse HEAD)" = "cb3d4ee9b47d0c5aae855b12379378ea1439675c"
RUN mkdir -p /out \
  && make -C src -j2 build ARCH=x86-64 \
  && install -m 0555 src/stockfish /out/stockfish \
  && printf 'uci\nquit\n' | /out/stockfish | grep -F 'Stockfish 18' \
  && make -C src clean \
  && rm -rf .git \
  && tar -czf /out/stockfish-18-source.tar.gz .

FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --config.node-linker=hoisted
RUN node scripts/build-node-artifacts.mjs

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
ENV STOCKFISH_PATH=/opt/stockfish/stockfish
WORKDIR /app
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/apps/worker/dist ./apps/worker/dist
COPY --from=build --chown=node:node /app/packages/db/migrations ./apps/worker/migrations
COPY --from=build --chown=node:node /app/packages/db/migrations ./packages/db/migrations
COPY --from=stockfish-build --chmod=0555 /out/stockfish /opt/stockfish/stockfish
COPY --from=stockfish-build /stockfish/Copying.txt /usr/share/licenses/stockfish/COPYING
COPY --from=stockfish-build /out/stockfish-18-source.tar.gz /usr/share/stockfish/stockfish-18-source.tar.gz
LABEL io.chess-intelligent.stockfish.version="18" \
  io.chess-intelligent.stockfish.source="https://github.com/official-stockfish/Stockfish" \
  io.chess-intelligent.stockfish.source-revision="cb3d4ee9b47d0c5aae855b12379378ea1439675c"
USER node
CMD ["node", "apps/worker/dist/worker.js"]
