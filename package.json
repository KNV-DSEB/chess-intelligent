{
  "name": "chess-intelligent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:node-artifacts": "node scripts/build-node-artifacts.mjs",
    "dev": "pnpm infra:up && pnpm db:migrate && pnpm ontology:sync && pnpm --parallel --filter @chess-intelligent/api --filter @chess-intelligent/web --filter @chess-intelligent/worker dev",
    "dev:apps": "pnpm --parallel --filter @chess-intelligent/api --filter @chess-intelligent/web --filter @chess-intelligent/worker dev",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @chess-intelligent/db migrate",
    "ontology:validate": "tsx packages/db/src/ontology-validate-cli.ts",
    "ontology:sync": "tsx packages/db/src/ontology-sync-cli.ts",
    "academy:bootstrap-owner": "tsx apps/api/src/academy-bootstrap-owner-cli.ts",
    "academy:bootstrap-owner:production": "node apps/api/dist/academy-bootstrap-owner-cli.js",
    "benchmark:academy": "tsx packages/db/src/academy-benchmark-cli.ts",
    "db:backup": "tsx packages/db/src/backup-cli.ts",
    "db:restore:verify": "tsx packages/db/src/restore-verify-cli.ts",
    "verify:production:database": "tsx packages/db/src/production-verification-cli.ts",
    "test:postgres": "vitest run packages/db/src/postgres-verification.test.ts",
    "verify:production": "pnpm check && pnpm build && pnpm verify:production:database",
    "audit:dependencies": "pnpm audit --prod --audit-level high --registry https://registry.npmjs.org",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc --project scripts/acceptance/tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
