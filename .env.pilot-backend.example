# Operator template for docker-compose.pilot-backend.yml. Never commit the populated file.
# Repository and digest are separate so Compose cannot fall back to a mutable image tag.
API_IMAGE_REPOSITORY=registry.example/chess-intelligent-api
API_IMAGE_DIGEST=replace_with_64_hex_api_digest
WORKER_IMAGE_REPOSITORY=registry.example/chess-intelligent-worker
WORKER_IMAGE_DIGEST=replace_with_64_hex_worker_digest
API_PUBLIC_HOST=api.pilot.example.com
WEB_PUBLIC_ORIGIN=https://app.pilot.example.com
DATABASE_URL=postgresql://pilot_user:replace_with_encoded_password@managed-postgres.example:5432/pilot?sslmode=require
EMAIL_FROM=Chess Academy <no-reply@pilot.example.com>
SMTP_HOST=smtp.transactional-provider.example
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
STOCKFISH_HOST_PATH=/absolute/operator/path/to/stockfish
STOCKFISH_PATH_CONTAINER=/opt/stockfish/stockfish
API_DB_POOL_MAX=10
WORKER_DB_POOL_MAX=5
GROUNDED_AI_PROVIDER=DISABLED
GROUNDED_AI_API_KEY=
GROUNDED_AI_BASE_URL=https://api.openai.com/v1
GROUNDED_AI_MODEL=gpt-5.6-terra
GROUNDED_AI_TIMEOUT_MS=30000
GROUNDED_AI_INPUT_USD_PER_MILLION=2
GROUNDED_AI_OUTPUT_USD_PER_MILLION=12
