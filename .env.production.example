# Copy to an operator-controlled environment file. All values below are placeholders.
POSTGRES_DB=replace_with_database_name
POSTGRES_ADMIN_USER=replace_with_admin_user
POSTGRES_ADMIN_PASSWORD=replace_with_admin_password
APP_DATABASE_USER=replace_with_runtime_user
# Use a URL-safe value or percent-encode it before composing DATABASE_URL.
APP_DATABASE_PASSWORD=replace_with_runtime_password
PUBLIC_HOST=academy.example.com
EMAIL_FROM=Chess Academy <no-reply@academy.example.com>
STOCKFISH_HOST_PATH=/absolute/operator/path/to/stockfish
STOCKFISH_PATH_CONTAINER=/opt/stockfish/stockfish
API_DB_POOL_MAX=10
WORKER_DB_POOL_MAX=5
